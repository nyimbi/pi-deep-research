{
  "name": "pi-deep-research",
  "version": "0.5.0",
  "description": "Deep research skill for pi \u2014 structured search, reflection, and analysis.",
  "keywords": [
    "pi-package",
    "research",
    "web-search",
    "deep-research"
  ],
  "license": "MIT",
  "author": "agiroad",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/czhiming-maker/pi-deep-research.git"
  },
  "homepage": "https://github.com/czhiming-maker/pi-deep-research#readme",
  "files": [
    "pi-deep-research/SKILL.md",
    "extension.ts",
    "src/",
    "examples/",
    "prompts/",
    "references/",
    "docs/preview.mp4",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.ts",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-lines=98 --test-coverage-branches=85 --test-coverage-functions=97 test/*.test.ts",
    "prepublishOnly": "npm test && npm run typecheck",
    "release:patch": "node scripts/release.mjs patch",
    "release:minor": "node scripts/release.mjs minor",
    "release:major": "node scripts/release.mjs major",
    "typecheck": "tsc --noEmit",
    "docs-qa": "python3 scripts/docs_qa.py --canary && python3 scripts/docs_qa.py --root . --errors-only docs/research",
    "retrieval-eval": "node scripts/retrieval-eval.ts",
    "entailment-eval": "node scripts/entailment-eval.ts"
  },
  "pi": {
    "skills": [
      "./pi-deep-research"
    ],
    "prompts": [
      "./prompts"
    ],
    "extensions": [
      "./extension.ts"
    ],
    "image": "https://raw.githubusercontent.com/czhiming-maker/pi-deep-research/main/docs/card.png",
    "video": "./docs/preview.mp4"
  },
  "dependencies": {
    "jiti": "^2.7.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.3",
    "@sinclair/typebox": "^0.34.52",
    "@types/node": "^26.3.0",
    "typescript": "^7.0.2"
  }
}
